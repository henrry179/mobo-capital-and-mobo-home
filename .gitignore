# --- 密钥与环境 -------------------------------------------------------------
.env
.env.*
!.env.example
mobo-stack.env
*.pem
*.key
*.crt
secrets/

# --- 控制台运行时数据（由 collect-status.sh / quality-gate.sh 生成）-------------
services/console/data/*.json

# --- 静态站点生成产物（由 CLI 导出，勿入库）--------------------------------
sites/*/data/*.json
sites/*/internal/*.json

# --- 运行时数据卷 -----------------------------------------------------------
deploy/volumes/*
!deploy/volumes/*/
!deploy/volumes/**/.gitkeep
deploy/volumes/**/data/
deploy/volumes/**/*.db
deploy/volumes/**/*.sqlite
deploy/volumes/backup_staging/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Node / 前端 ------------------------------------------------------------
node_modules/
.next/
.cache/
public/build/

# --- 日志与临时文件 ---------------------------------------------------------
*.log
*.dump
*.sql.gz
*.tar.gz
*.zip
tmp/
temp/
.DS_Store
Thumbs.db
desktop.ini

# --- 编辑器 -----------------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json

# --- 本地恢复演练 -----------------------------------------------------------
restore-staging/
drill-output/

# --- 自检证据留痕（默认不入库，重要文件手动 git add -f）---------------------
docs/05-运维与灾备/证据/*/
!docs/05-运维与灾备/证据/README.md
