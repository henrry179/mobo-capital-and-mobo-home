# =============================================================================
# 莫伯双站系统（MoBoCapital.com / MoBoHome.com）环境变量模板 · v2.1
# 复制为 .env 后填写；生产环境 chmod 600 .env
# 注意：
#   1) 含 $ 的值（如 Bcrypt 哈希）必须用单引号包裹，避免 Compose 变量插值
#   2) 本文件不得填入真实密钥；真实值只存服务器 /opt/mobo-stack/.env 与密码管理器
#   3) 命名规范（v2.1 统一口径，v1.1 的 CLI_*/ARCHIVE_DB_* 已废弃）：
#      PG_* = PostgreSQL；ALIYUN_* = 阿里云账号；OSS_* = 对象存储
# =============================================================================

# --- 基础 -------------------------------------------------------------------
COMPOSE_PROJECT_NAME=mobo-stack
TZ=Asia/Shanghai
ACME_EMAIL=admin@mobocapital.com

# --- 域名拓扑（双主站 + 生产中台子域）--------------------------------------
# 网站 A 主站：莫伯资本（投研/自媒体/基金孵化）
DOMAIN_CAPITAL=mobocapital.com
# 网站 B 主站：莫伯之家（个人数字档案）
DOMAIN_HOME=mobohome.com
# 内部生产力中台
DOMAIN_PKM=kb.mobocapital.com
DOMAIN_N8N=n8n.mobocapital.com
DOMAIN_ADMIN=admin.mobocapital.com
DOMAIN_LAB=lab.mobohome.com

# --- 网关鉴权 ---------------------------------------------------------------
# 生成：docker run --rm caddy:2.9-alpine caddy hash-password --plaintext '你的强密码'
# 该哈希同时保护 /internal/*（内网驾驶舱）与 /lab/*（看板实验室）
CADDY_ADMIN_USER=mobo
CADDY_ADMIN_PASSWORD_HASH='$2a$14$REPLACE_WITH_REAL_BCRYPT_HASH'

# --- PostgreSQL 16 双库物理隔离 ---------------------------------------------
# 超级用户：仅初始化与灾备使用，业务应用禁用
PG_SUPER_USER=postgres
PG_SUPER_PASSWORD=ChangeMe_SuperRootPass_2026!
# 容器内服务名；宿主机 CLI 走 127.0.0.1
PG_HOST=postgres
PG_PORT=5432
# 网站 A（莫伯资本）业务账号：intel + capital Schema
PG_DB_MOBOBRAIN=db_mobobrain
PG_USER_MOBOBRAIN=user_mobobrain
PG_PASS_MOBOBRAIN=ChangeMe_MoboBrainPass_2026!
# 网站 B（莫伯之家）业务账号：archive Schema
PG_DB_ARCHIVE=db_archive
PG_USER_ARCHIVE=user_archive
PG_PASS_ARCHIVE=ChangeMe_ArchiveVaultPass_2026!
# n8n 自身 Schema 账号
N8N_DB_USER=user_n8n
N8N_DB_PASSWORD=ChangeMe_N8nPass_2026!
# 看板只读账号
DASHBOARD_DB_USER=user_dashboard_ro
DASHBOARD_DB_PASSWORD=ChangeMe_DashboardReadOnly_2026!
# 备份只读账号
BACKUP_DB_USER=user_backup
BACKUP_DB_PASSWORD=ChangeMe_BackupReadOnly_2026!

# --- 思源 / n8n -------------------------------------------------------------
SIYUAN_ACCESS_AUTH_CODE=ChangeMe_SiyuanAuthCode_2026!
# 必须与备份一致，丢失后 n8n 凭证无法解密
N8N_ENCRYPTION_KEY=ChangeMe_Random32CharKeyForN8nVault!
# N8N_HOST / N8N_PROTOCOL / WEBHOOK_URL 由 docker-compose.yml 根据 DOMAIN_N8N 组装

# --- 阿里云账号与 OSS ------------------------------------------------------
# RAM 子账号：仅授权两个 Bucket 的 PutObject/GetObject/DeleteObject/ListObjects
ALIYUN_ACCESS_KEY_ID=LTAI5tREPLACE_WITH_REAL_AK
ALIYUN_ACCESS_KEY_SECRET=REPLACE_WITH_REAL_SK
# 容器内强制使用内网 Endpoint（0 流量费）；公网仅供本地 CLI 使用
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET_PUBLIC=mobobrain-assets-pub
OSS_BUCKET_PRIVATE=mobo-archive-private-hz
# 公开图床防盗链允许的来源（逗号分隔，脚本会拆分）
OSS_REFERER_WHITELIST=https://www.mobocapital.com,https://mobocapital.com,https://www.mobohome.com,https://mobohome.com

# --- 静态站点输出目录（由 CLI 预生成 JSON，Caddy 只读分发）-------------------
MOBOCAPITAL_WEB_DIR=/opt/mobo-stack/sites/mobocapital
MOBOHOME_WEB_DIR=/opt/mobo-stack/sites/mobohome

# --- Restic 备份 ------------------------------------------------------------
RESTIC_REPOSITORY=s3:https://oss-cn-hangzhou-internal.aliyuncs.com/mobo-archive-private-hz/restic-cold-backup
RESTIC_PASSWORD=ChangeMe_ResticMasterEncryptionKey_2026!
AWS_DEFAULT_REGION=cn-hangzhou
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_RUN_ON_START=0

# --- 微信公众号草稿箱直推（n8n 工作流 #2）---------------------------------
WECHAT_APPID=wxREPLACE_WITH_REAL_APPID
WECHAT_SECRET=REPLACE_WITH_REAL_SECRET
WECHAT_DEFAULT_THUMB_MEDIA_ID=REPLACE_WITH_REAL_MEDIA_ID

# --- 告警与巡检 -------------------------------------------------------------
# 飞书/钉钉群机器人 Webhook（mobo_watchdog.sh 使用）
ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_WITH_REAL_HOOK

# --- AI / Embedding ---------------------------------------------------------
# 先做 OpenAI-compatible 适配层；具体模型与维度以实际服务为准
LLM_PROVIDER=openai-compatible
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=ChangeMe_LLM_API_Key
LLM_MODEL=your-chat-model

EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_BASE=https://api.example.com/v1
EMBEDDING_API_KEY=ChangeMe_Embedding_API_Key
EMBEDDING_MODEL=text-embedding-3-small
# 必须与数据库 vector(n) 的维度一致；当前基线为 1536
EMBEDDING_DIM=1536
