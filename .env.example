# =============================================================================
# 莫伯双站系统环境变量模板
# 复制为 .env 后填写；生产环境 chmod 600 .env
# 注意：含 $ 的值（如 Bcrypt 哈希）必须用单引号包裹，避免 Compose 变量插值
# =============================================================================

# --- 基础 -------------------------------------------------------------------
COMPOSE_PROJECT_NAME=mobo-stack
TZ=Asia/Shanghai
ACME_EMAIL=admin@example.com

# --- 域名（建议一个主域名 + 多子域）----------------------------------------
DOMAIN_WWW=www.example.com
DOMAIN_KB=kb.example.com
DOMAIN_N8N=n8n.example.com
DOMAIN_ARCHIVE=archive.example.com
DOMAIN_ADMIN=admin.example.com

# --- 网关鉴权 ---------------------------------------------------------------
# 生成：docker run --rm caddy:2.9-alpine caddy hash-password --plaintext '你的强密码'
CADDY_ADMIN_USER=mobo
CADDY_ADMIN_PASSWORD_HASH='$2a$14$REPLACE_WITH_REAL_BCRYPT_HASH'

# --- PostgreSQL 超级用户 ----------------------------------------------------
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=ChangeMe_SuperRootPass_2026!

# --- 网站 A：MoBoBrain 数据库 ----------------------------------------------
MOBOBRAIN_DB_NAME=db_mobobrain
MOBOBRAIN_DB_USER=user_mobobrain
MOBOBRAIN_DB_PASSWORD=ChangeMe_MoboBrainPass_2026!

# n8n 使用 db_mobobrain 内的独立 Schema，避免污染 intel 业务表
N8N_DB_USER=user_n8n
N8N_DB_PASSWORD=ChangeMe_N8nPass_2026!

# --- 网站 B：Archive 数据库 ------------------------------------------------
ARCHIVE_DB_NAME=db_archive
ARCHIVE_DB_USER=user_archive
ARCHIVE_DB_PASSWORD=ChangeMe_ArchiveVaultPass_2026!

# 看板只读账号 / 备份只读账号
DASHBOARD_DB_USER=user_dashboard_ro
DASHBOARD_DB_PASSWORD=ChangeMe_DashboardReadOnly_2026!
BACKUP_DB_USER=user_backup
BACKUP_DB_PASSWORD=ChangeMe_BackupReadOnly_2026!

# --- 思源 / n8n -------------------------------------------------------------
SIYUAN_ACCESS_AUTH_CODE=ChangeMe_SiyuanAuthCode_2026!
N8N_ENCRYPTION_KEY=ChangeMe_Random32CharKeyForN8nVault!
# N8N_HOST / N8N_PROTOCOL / WEBHOOK_URL 由 docker-compose.yml 根据 DOMAIN_N8N 组装

# --- 阿里云 OSS -------------------------------------------------------------
# 服务器与 Bucket 必须同地域；容器内使用 -internal Endpoint
OSS_INTERNAL_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_PUBLIC=mobobrain-assets-pub
OSS_BUCKET_ARCHIVE=mobo-archive-private-hz
OSS_ACCESS_KEY_ID=LTAI5tREPLACE_WITH_REAL_AK
OSS_ACCESS_KEY_SECRET=REPLACE_WITH_REAL_SK
OSS_REGION=cn-hangzhou

# 公开图床防盗链允许的来源（逗号分隔，脚本会拆分）
OSS_REFERER_WHITELIST=https://www.example.com,https://example.com

# --- Restic 备份 ------------------------------------------------------------
RESTIC_REPOSITORY=s3:https://oss-cn-hangzhou-internal.aliyuncs.com/mobo-archive-private-hz/restic-cold-backup
RESTIC_PASSWORD=ChangeMe_ResticMasterEncryptionKey_2026!
AWS_DEFAULT_REGION=cn-hangzhou
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_RUN_ON_START=0

# --- AI / Embedding ---------------------------------------------------------
# 先做 OpenAI-compatible 适配层；具体模型与维度以实际服务为准
LLM_PROVIDER=openai-compatible
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=ChangeMe_LLM_API_Key
LLM_MODEL=your-chat-model

EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_BASE=https://api.example.com/v1
EMBEDDING_API_KEY=ChangeMe_Embedding_API_Key
EMBEDDING_MODEL=text-embedding-3-small
# 必须与数据库 vector(n) 的维度一致；当前基线为 1536
EMBEDDING_DIM=1536

# --- 应用连接 ---------------------------------------------------------------
# 看板容器内固定使用服务名 postgres:5432（由 docker-compose.yml 注入
# ARCHIVE_DB_HOST / ARCHIVE_DB_PORT / ARCHIVE_DB_NAME / ARCHIVE_DB_USER）
# 变量名复用上面的 ARCHIVE_DB_* 与 DASHBOARD_DB_*，此处不重复定义

# CLI 在宿主机运行
CLI_DATABASE_HOST=127.0.0.1
CLI_DATABASE_PORT=5432
CLI_ARCHIVE_DB_NAME=db_archive
CLI_ARCHIVE_DB_USER=user_archive
CLI_ARCHIVE_DB_PASSWORD=ChangeMe_ArchiveVaultPass_2026!
CLI_MOBOBRAIN_DB_NAME=db_mobobrain
CLI_MOBOBRAIN_DB_USER=user_mobobrain
CLI_MOBOBRAIN_DB_PASSWORD=ChangeMe_MoboBrainPass_2026!
